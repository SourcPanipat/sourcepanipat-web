# SourcePanipat Dual-Database & Media Environment Variables

# 1. Edge-Cached Catalog Database (Turso libSQL)
TURSO_DATABASE_URL="libsql://sourcepanipat-catalog.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. Transactional & Auth Database (Supabase PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# 3. Media CDN (Cloudflare R2 S3-Compatible API)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sourcepanipat-media"
R2_PUBLIC_DOMAIN="https://media.sourcepanipat.com"

# 4. App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_TRADER_NUMBER="+919876543210"
NEXT_PUBLIC_QC_SHIELD_FEE="1000"
